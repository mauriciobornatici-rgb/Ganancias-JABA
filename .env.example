# Copiar a .env para desarrollo local. Nunca guardar aquÃ­ la URL productiva.
# Vercel Production: cargar DATABASE_URL real exclusivamente en el panel de Vercel/Production.
DATABASE_URL="mysql://jaba_test:jaba_test_pass@127.0.0.1:3317/ganancias_jaba_test"
APP_ENV="test-db"

# Seguridad simple de la app. Configurar valores reales en Vercel, no en GitHub.
AUTH_PASSWORD="REEMPLAZAR_CLAVE_APP_NO_COMMIT"
AUTH_SECRET="REEMPLAZAR_SECRETO_LARGO_ALEATORIO_NO_COMMIT"

# P31.5: token para que un monitor externo consulte /api/health sin sesion (header x-health-token).
# Minimo 16 caracteres; vacio = acceso por token deshabilitado.
HEALTH_CHECK_TOKEN=""

# Token exclusivo del puente UiPath. Minimo 32 caracteres y distinto de AUTH_SECRET.
# Configurarlo solo en Ganancias Production y copiar el mismo valor en Configuracion > Puente de UiPath.
UIPATH_INTEGRATION_TOKEN=""

# Valores usados por scripts/check-deployment-db-safety.mjs para reconocer la DB productiva.
PRODUCTION_DATABASE_HOSTS="srv1199.hstgr.io,193.203.175.56"
PRODUCTION_DATABASE_NAME="u669600172_ganancias_jaba"
