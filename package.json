{
  "name": "ganancias-jaba",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-test-db-command.mjs dev",
    "dev:testdb": "node scripts/run-test-db-command.mjs dev",
    "dev:turbopack": "node scripts/run-test-db-command.mjs dev-turbopack",
    "prebuild": "node scripts/check-deployment-db-safety.mjs",
    "build": "next build --webpack",
    "build:turbopack": "next build",
    "start": "node scripts/run-test-db-command.mjs start",
    "lint": "eslint",
    "test": "vitest run --exclude \".claude/**\"",
    "test:integration": "node scripts/run-test-db-command.mjs validate-integration",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "verify": "npm run test && npm run lint && npm run typecheck && npm run prisma:validate && npm run build",
    "db:backup": "node scripts/backup-db.mjs",
    "db:test:up": "docker compose up -d mysql-test",
    "db:test:down": "docker compose down",
    "db:test:reset": "docker compose down -v && docker compose up -d mysql-test",
    "db:test:migrate": "node scripts/run-test-db-command.mjs migrate",
    "db:prod:migrate": "node scripts/run-prod-migration.mjs",
    "db:test:seed": "node scripts/seed-test-db.mjs",
    "db:test:validate": "node scripts/run-test-db-command.mjs validate",
    "db:test:validate:excel": "node scripts/run-test-db-command.mjs validate-excel",
    "db:test:studio": "node scripts/run-test-db-command.mjs studio",
    "start:testdb": "node scripts/run-test-db-command.mjs start"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "decimal.js": "^10.6.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "mariadb": "^3.5.2",
    "next": "16.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.23",
    "fast-uri": "3.1.5",
    "nanoid": "3.3.18",
    "deepmerge-ts": "8.0.1",
    "find-my-way": "9.7.0",
    "valibot": "1.4.2"
  }
}
