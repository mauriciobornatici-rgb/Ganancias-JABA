  finalBalance          Decimal   @db.Decimal(18, 2) // Impuesto a pagar o saldo a favor
  
  // JustificaciÃ³n Patrimonial (ConciliaciÃ³n)
  computedConsumo       Decimal   @db.Decimal(18, 2) // Consumo obtenido por diferencia
  justificationDiff     Decimal   @db.Decimal(18, 2) @default(0) // Diferencia de cuadre (debe ser 0)
  
