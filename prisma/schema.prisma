// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "mysql"
}

enum VatCondition {
  RESPONSABLE_INSCRIPTO
  EXENTO
  MONOTRIBUTO
  OTRO
}

enum GrossIncomeRegime {
  NONE
  ARBA_LOCAL
  CM_REGIMEN_GENERAL
  CM_REGIMEN_ESPECIAL
  ARBA_SIMPLIFICADO
}

enum ConventionRegime {
  NONE
  GENERAL
  ESPECIAL
}

enum FiscalDocumentDirection {
  SALE
  PURCHASE
  ADJUSTMENT
}

enum VatLineKind {
  TAXED
  EXEMPT
  NON_TAXED
}

enum VatSettlementStatus {
  DRAFT
  IN_REVIEW
  READY_TO_FILE
  FILED_EXTERNALLY
  CLOSED
  ANNULLED
}

enum GrossIncomeSettlementStatus {
  DRAFT
  IN_REVIEW
  READY_TO_FILE
  FILED_EXTERNALLY
  CLOSED
  ANNULLED
}

enum TaxCreditTax {
  VAT
  GROSS_INCOME
  GANANCIAS
}

enum TaxCreditKind {
  WITHHOLDING
  PERCEPTION
  PAYMENT_ON_ACCOUNT
  TECHNICAL_CARRY_FORWARD
  FREE_AVAILABILITY
}

enum GainsAllocationKind {
  SALE_TAXED
  SALE_EXEMPT
  INVENTORY_PURCHASE
  DEDUCTIBLE_EXPENSE
  FIXED_ASSET
  NON_DEDUCTIBLE
  VAT_NON_COMPUTABLE
  OTHER
}

// ==========================================
// 1. SEGURIDAD Y MULTIUSUARIOS
// ==========================================

model User {
  id            String             @id @default(uuid())
  email         String             @unique
  passwordHash  String
  firstName     String
  lastName      String
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  
  // Relaciones
  roleId        String
  role          Role               @relation(fields: [roleId], references: [id])
  clientAccess  ClientUserAccess[]
  auditLogs     AuditLog[]
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique // owner, admin, contador, revisor, carga_datos, solo_lectura
  description String?
  
  // Relaciones
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // e.g., "CLIENT_CREATE", "RETURN_CLOSE", "PARAM_EDIT"
  description String?
  
  // Relaciones
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model ClientUserAccess {
  clientId  String
  userId    String
  canEdit   Boolean  @default(true)
  createdAt DateTime @default(now())

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clientId, userId])
}

// ==========================================
// 2. CLIENTES (MAESTRO DE CONTRIBUYENTES)
// ==========================================

model Client {
  id             String             @id @default(uuid())
  cuit           String             @unique // Formato: XX-XXXXXXXX-X
  name           String             // RazÃ³n Social / Nombre
  type           String             // Persona Humana, SucesiÃ³n Indivisa, Sociedad
  fiscalCondition String            // Responsable Inscripto, etc.
  mainActivity   String             // CABA, Buenos Aires, Convenio Multilateral
  responsibleName String?           // Responsable interno asignado
  status         String             @default("Activo") // Activo, Suspendido, Inactivo
  notes          String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Relaciones
  userAccess     ClientUserAccess[]
  taxReturns     TaxReturn[]
  taxProfiles    ClientTaxProfileVersion[]
  fiscalPeriods  FiscalPeriod[]
  conventionCoefficients ConventionCoefficientVersion[]
}

// ==========================================
// 3. PARÃMETROS NORMATIVOS Y AÃ‘OS FISCALES
// ==========================================

model FiscalYear {
  id            String             @id @default(uuid())
  year          Int                @unique // e.g., 2024, 2025, 2026
  isEnabled     Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Relaciones
  taxReturns       TaxReturn[]
  parameterSets    TaxParameterSet[]
  indices          UpdateIndex[]
  art94Brackets    TaxArt94Bracket[]
}

model TaxParameterSet {
  id                  String     @id @default(uuid())
  fiscalYearId        String
  fiscalYear          FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  
  // Deducciones Art 30
  minimoNoImponible   Decimal    @db.Decimal(18, 4)
  conyuge             Decimal    @db.Decimal(18, 4)
  hijo                Decimal    @db.Decimal(18, 4)
  hijoIncapacitado    Decimal    @db.Decimal(18, 4)
  
  // Deducciones Especiales Art 30 Inc C
  especialAutonomo    Decimal    @db.Decimal(18, 4)
  especialEmprendedor Decimal    @db.Decimal(18, 4)
  especialDependiente Decimal    @db.Decimal(18, 4)
  
  // Topes Deducciones Generales
  topeServicioDomestico Decimal  @db.Decimal(18, 4)
  topeSeguroVida        Decimal  @db.Decimal(18, 4)
  topeSeguroRetiro      Decimal  @db.Decimal(18, 4)
  topeGastosSepelio     Decimal  @db.Decimal(18, 4)
  topeInteresHipoteca   Decimal  @db.Decimal(18, 4)
  topeGastosEducativos  Decimal  @db.Decimal(18, 4)

  status              String     @default("borrador") // borrador, validado, reemplazado
  sourceLaw           String?    // Fuente legal de referencia
  version             Int        @default(1)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  art94Brackets       TaxArt94Bracket[]
  taxReturns          TaxReturn[]

  @@unique([fiscalYearId, version])
}

model TaxArt94Bracket {
  id                String           @id @default(uuid())
  fiscalYearId      String
  fiscalYear        FiscalYear       @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  
  taxParameterSetId String?
  taxParameterSet   TaxParameterSet? @relation(fields: [taxParameterSetId], references: [id], onDelete: Cascade)
  
  fromAmount        Decimal          @db.Decimal(18, 4)
  toAmount          Decimal?         @db.Decimal(18, 4) // nulo si es el tramo "en adelante"
  fixedAmount       Decimal          @db.Decimal(18, 4)
  percentage        Decimal          @db.Decimal(6, 4)  // e.g., 0.05 a 0.35
  excessOf          Decimal          @db.Decimal(18, 4)

  @@index([fiscalYearId])
  @@index([taxParameterSetId])
}

model UpdateIndex {
  id            String     @id @default(uuid())
  fiscalYearId  String
  fiscalYear    FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  
  monthIndex    Int        // 1 to 12
  monthName     String     // Enero, Febrero...
  ipcValue      Decimal    @db.Decimal(18, 6)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([fiscalYearId, monthIndex])
}

// ==========================================
// 4. DECLARACIÃ“N JURADA (CABECERA)
// ==========================================

model TaxReturn {
  id                String           @id @default(uuid())
  clientId          String
  fiscalYearId      String
  taxParameterSetId String?
  status            String           @default("Borrador") // Borrador, En_Revision, Observada, Lista_Presentar, Presentada, Cerrada, Rectificada
  version           Int              @default(0)          // 0 = Original, 1 = Rectificativa 1...
  notes             String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  client            Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fiscalYear        FiscalYear       @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  taxParameterSet   TaxParameterSet? @relation(fields: [taxParameterSetId], references: [id])

  // Relaciones transaccionales de la liquidaciÃ³n
  sales         SalesInvoice[]
  purchases     PurchaseInvoice[]
  fixedAssets   FixedAsset[]
  inventory     InventoryValue[]
  bankAccounts  BankAccountBalance[]
  cashHoldings  CashHolding[]
  receivables   ReceivableDebt[]
  liabilities   PayableDebt[]
  withholdings  TaxWithholding[]
  personalAssets PersonalAsset[]
  personalLiabilities PersonalLiability[]
  justifications  PatrimonialJustification[]
  generalDeduction GeneralDeduction?
  personalDeduction PersonalDeduction?
  axiStaticItems  AxiStaticItem[]
  axiDynamicItems AxiDynamicItem[]
  calculations   CalculationRun[]
  attachments    Attachment[]
  importBatches  ImportBatch[]
  annualFiscalConsolidations AnnualFiscalConsolidationSnapshot[]
  fixedAssetImportCandidates FixedAssetImportCandidate[]
  rectificationLinksAsOriginal RectificationLink[] @relation("OriginalReturn")
  rectificationLinksAsRectified RectificationLink[] @relation("RectifiedReturn")

  @@unique([clientId, fiscalYearId, version])
  @@index([clientId])
  @@index([fiscalYearId])
}

model FixedAssetImportCandidate {
  id                      String    @id @default(uuid())
  taxReturnId             String
  sourceFiscalDocumentId  String
  sourceMonth             Int
  description             String
  counterpartyName        String?
  purchaseDate            DateTime
  originalCost            Decimal   @db.Decimal(18, 2)
  status                  String    @default("PENDING")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  taxReturn               TaxReturn @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)

  @@unique([taxReturnId, sourceFiscalDocumentId])
  @@index([taxReturnId, status])
}

model RectificationLink {
  id               String    @id @default(uuid())
  originalId       String
  rectifiedId      String
  reason           String?   @db.Text
  createdAt        DateTime  @default(now())

  originalReturn   TaxReturn @relation("OriginalReturn", fields: [originalId], references: [id], onDelete: Cascade)
  rectifiedReturn  TaxReturn @relation("RectifiedReturn", fields: [rectifiedId], references: [id], onDelete: Cascade)

  @@unique([originalId, rectifiedId])
}

// ==========================================
// 4B. LIBRO FISCAL MENSUAL (IVA + IIBB)
// ==========================================

model ClientTaxProfileVersion {
  id                    String             @id @default(uuid())
  clientId              String
  validFrom             DateTime
  validTo               DateTime?
  vatCondition          VatCondition
  grossIncomeRegime     GrossIncomeRegime
  conventionRegime      ConventionRegime   @default(NONE)
  arbaRegistrationNumber String?
  cmRegistrationNumber  String?
  sourceReference       String?
  approvedBy            String?
  approvedAt            DateTime?
  notes                 String?            @db.Text
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  client                Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  activities            ClientTaxActivity[]
  jurisdictions         ClientTaxJurisdiction[]
  fiscalPeriods         FiscalPeriod[]

  @@unique([clientId, validFrom])
  @@index([clientId, validTo])
}

model ClientTaxActivity {
  id                String                  @id @default(uuid())
  taxProfileId      String
  activityCode      String
  description       String
  isPrimary         Boolean                 @default(false)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  taxProfile        ClientTaxProfileVersion @relation(fields: [taxProfileId], references: [id], onDelete: Cascade)

  @@unique([taxProfileId, activityCode])
  @@index([taxProfileId, isPrimary])
}

model ClientTaxJurisdiction {
  id                  String                  @id @default(uuid())
  taxProfileId        String
  jurisdictionCode    String
  registrationNumber  String?
  // Alícuota de IIBB de la jurisdicción (fracción, ej. 0.050000 = 5%). Null = sin cargar (se trata como 0).
  taxRate             Decimal?                @db.Decimal(8, 6)
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  taxProfile          ClientTaxProfileVersion @relation(fields: [taxProfileId], references: [id], onDelete: Cascade)

  @@unique([taxProfileId, jurisdictionCode])
  @@index([jurisdictionCode])
}

model FiscalPeriod {
  id                  String                  @id @default(uuid())
  clientId            String
  taxProfileId        String
  year                Int
  month               Int
  notes               String?                 @db.Text
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  client              Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  taxProfile          ClientTaxProfileVersion @relation(fields: [taxProfileId], references: [id], onDelete: Restrict)
  documents           FiscalDocument[]
  taxCredits          TaxCreditRecord[]
  vatSettlements      VatSettlement[]
  grossIncomeSettlements GrossIncomeSettlement[]
  annualConsolidationPeriods AnnualFiscalConsolidationPeriod[]

  @@unique([clientId, year, month])
  @@index([clientId, year])
  @@index([taxProfileId])
}

model FiscalDocument {
  id                  String                  @id @default(uuid())
  fiscalPeriodId      String
  documentKey         String
  direction           FiscalDocumentDirection
  issueDate           DateTime
  voucherType         String
  voucherNumber       String
  counterpartyName    String?
  counterpartyCuit    String?
  netAmount           Decimal                 @db.Decimal(18, 2)
  totalAmount         Decimal                 @db.Decimal(18, 2)
  source              String                  @default("ARCA")
  sourceFileName      String?
  sourceFileHash      String?
  // Revisión del usuario antes de liquidar: si se desmarca, el comprobante NO entra en la
  // liquidación de IVA/IIBB (queda en el libro para trazabilidad, pero excluido del cálculo).
  includedInSettlement Boolean                @default(true)
  notes               String?                 @db.Text
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  fiscalPeriod        FiscalPeriod            @relation(fields: [fiscalPeriodId], references: [id], onDelete: Cascade)
  vatLines            FiscalDocumentVatLine[]
  allocations         FiscalDocumentAllocation[]
  taxCredits          TaxCreditRecord[]

  @@unique([fiscalPeriodId, documentKey])
  @@index([fiscalPeriodId, issueDate])
  @@index([counterpartyCuit])
}

model FiscalDocumentVatLine {
  id                  String          @id @default(uuid())
  fiscalDocumentId    String
  kind                VatLineKind
  taxableBase         Decimal         @db.Decimal(18, 2)
  rate                Decimal         @db.Decimal(8, 6)
  vatAmount           Decimal         @db.Decimal(18, 2)
  creditComputable    Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  fiscalDocument      FiscalDocument  @relation(fields: [fiscalDocumentId], references: [id], onDelete: Cascade)

  @@index([fiscalDocumentId])
  @@index([kind, rate])
}

model FiscalDocumentAllocation {
  id                  String          @id @default(uuid())
  fiscalDocumentId    String
  gainsKind           GainsAllocationKind
  allocatedNetAmount  Decimal         @db.Decimal(18, 2)
  isDeductible        Boolean         @default(false)
  isGrossIncomeTaxable Boolean        @default(true)
  needsReview         Boolean         @default(true)
  notes               String?         @db.Text
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  fiscalDocument      FiscalDocument  @relation(fields: [fiscalDocumentId], references: [id], onDelete: Cascade)

  @@index([fiscalDocumentId])
  @@index([gainsKind, needsReview])
}

model TaxCreditRecord {
  id                  String          @id @default(uuid())
  fiscalPeriodId      String
  fiscalDocumentId    String?
  creditKey           String
  tax                 TaxCreditTax
  kind                TaxCreditKind
  jurisdictionCode    String?
  issueDate           DateTime
  agentCuit           String?
  agentName           String?
  certificateNumber   String?
  originalAmount      Decimal         @db.Decimal(18, 2)
  appliedAmount       Decimal         @default(0) @db.Decimal(18, 2)
  source              String          @default("MANUAL")
  // Revisión del usuario: si se desmarca, la ret/perc NO entra en la liquidación (queda registrada).
  includedInSettlement Boolean        @default(true)
  notes               String?         @db.Text
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  fiscalPeriod        FiscalPeriod    @relation(fields: [fiscalPeriodId], references: [id], onDelete: Cascade)
  fiscalDocument      FiscalDocument? @relation(fields: [fiscalDocumentId], references: [id], onDelete: SetNull)

  @@unique([fiscalPeriodId, creditKey])
  @@index([tax, jurisdictionCode])
  @@index([certificateNumber])
}

model VatSettlement {
  id                    String              @id @default(uuid())
  fiscalPeriodId        String
  originalSettlementId  String?
  version               Int                 @default(0)
  status                VatSettlementStatus @default(DRAFT)
  previousTechnicalBalance Decimal           @default(0) @db.Decimal(18, 2)
  debitFiscal           Decimal             @default(0) @db.Decimal(18, 2)
  creditFiscal          Decimal             @default(0) @db.Decimal(18, 2)
  technicalCarryForward Decimal             @default(0) @db.Decimal(18, 2)
  freeAvailabilityBalance Decimal           @default(0) @db.Decimal(18, 2)
  amountDue             Decimal             @default(0) @db.Decimal(18, 2)
  officialAmount        Decimal?            @db.Decimal(18, 2)
  officialReference     String?
  filedAt               DateTime?
  notes                 String?             @db.Text
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  fiscalPeriod          FiscalPeriod        @relation(fields: [fiscalPeriodId], references: [id], onDelete: Cascade)
  originalSettlement    VatSettlement?      @relation("VatSettlementRectifications", fields: [originalSettlementId], references: [id], onDelete: Restrict)
  rectifications        VatSettlement[]     @relation("VatSettlementRectifications")
  lines                 VatSettlementLine[]

  @@unique([fiscalPeriodId, version])
  @@index([status])
}

model VatSettlementLine {
  id                  String        @id @default(uuid())
  vatSettlementId     String
  concept             String
  rate                Decimal?      @db.Decimal(8, 6)
  amount              Decimal       @db.Decimal(18, 2)
  sourceReference     String?
  createdAt           DateTime      @default(now())

  vatSettlement       VatSettlement @relation(fields: [vatSettlementId], references: [id], onDelete: Cascade)

  @@index([vatSettlementId])
}

model GrossIncomeSettlement {
  id                    String                       @id @default(uuid())
  fiscalPeriodId        String
  originalSettlementId  String?
  version               Int                          @default(0)
  regime                GrossIncomeRegime
  status                GrossIncomeSettlementStatus  @default(DRAFT)
  totalDeterminedTax    Decimal                      @default(0) @db.Decimal(18, 2)
  totalCredits          Decimal                      @default(0) @db.Decimal(18, 2)
  totalBalance          Decimal                      @default(0) @db.Decimal(18, 2)
  totalFavorCarryForward Decimal                     @default(0) @db.Decimal(18, 2)
  officialAmount        Decimal?                     @db.Decimal(18, 2)
  officialReference     String?
  filedAt               DateTime?
  notes                 String?                      @db.Text
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  fiscalPeriod          FiscalPeriod                 @relation(fields: [fiscalPeriodId], references: [id], onDelete: Cascade)
  originalSettlement    GrossIncomeSettlement?       @relation("GrossIncomeSettlementRectifications", fields: [originalSettlementId], references: [id], onDelete: Restrict)
  rectifications        GrossIncomeSettlement[]      @relation("GrossIncomeSettlementRectifications")
  jurisdictionLines     GrossIncomeJurisdictionLine[]

  @@unique([fiscalPeriodId, version])
  @@index([regime, status])
}

model GrossIncomeJurisdictionLine {
  id                    String                  @id @default(uuid())
  grossIncomeSettlementId String
  jurisdictionCode      String
  activityCode          String?
  coefficient           Decimal?                @db.Decimal(12, 10)
  assignedBase          Decimal                 @db.Decimal(18, 2)
  taxRate               Decimal                 @db.Decimal(8, 6)
  determinedTax         Decimal                 @db.Decimal(18, 2)
  creditsApplied        Decimal                 @default(0) @db.Decimal(18, 2)
  balance               Decimal                 @db.Decimal(18, 2)
  favorCarryForward     Decimal                 @default(0) @db.Decimal(18, 2)
  createdAt             DateTime                @default(now())

  grossIncomeSettlement GrossIncomeSettlement   @relation(fields: [grossIncomeSettlementId], references: [id], onDelete: Cascade)

  @@index([grossIncomeSettlementId, jurisdictionCode])
}

model ConventionCoefficientVersion {
  id                  String                      @id @default(uuid())
  clientId            String
  year                Int
  version             Int                         @default(1)
  sourceReference     String?
  approvedBy          String?
  approvedAt          DateTime?
  notes               String?                     @db.Text
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  client              Client                      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  coefficientLines    ConventionCoefficientLine[]

  @@unique([clientId, year, version])
  @@index([clientId, year])
  @@index([year])
}

model ConventionCoefficientLine {
  id                    String                        @id @default(uuid())
  coefficientVersionId  String
  jurisdictionCode      String
  incomeCoefficient     Decimal                       @db.Decimal(12, 10)
  expenseCoefficient    Decimal                       @db.Decimal(12, 10)
  unifiedCoefficient    Decimal                       @db.Decimal(12, 10)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  coefficientVersion    ConventionCoefficientVersion  @relation(fields: [coefficientVersionId], references: [id], onDelete: Cascade)

  @@unique([coefficientVersionId, jurisdictionCode])
  @@index([jurisdictionCode])
}

model AnnualFiscalConsolidationSnapshot {
  id                    String                           @id @default(uuid())
  taxReturnId           String
  sourceHash            String
  salesNet              Decimal                          @default(0) @db.Decimal(18, 2)
  inventoryPurchases    Decimal                          @default(0) @db.Decimal(18, 2)
  deductibleExpenses    Decimal                          @default(0) @db.Decimal(18, 2)
  fixedAssetPurchases   Decimal                          @default(0) @db.Decimal(18, 2)
  nonDeductibleExpenses Decimal                          @default(0) @db.Decimal(18, 2)
  vatNonComputable      Decimal                          @default(0) @db.Decimal(18, 2)
  grossIncomeTax        Decimal                          @default(0) @db.Decimal(18, 2)
  createdAt             DateTime                         @default(now())
  confirmedAt           DateTime?

  taxReturn             TaxReturn                        @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)
  periods               AnnualFiscalConsolidationPeriod[]

  @@index([taxReturnId, confirmedAt])
  @@index([sourceHash])
}

model AnnualFiscalConsolidationPeriod {
  id                    String                           @id @default(uuid())
  consolidationSnapshotId String
  fiscalPeriodId        String
  month                 Int
  salesNet              Decimal                          @default(0) @db.Decimal(18, 2)
  inventoryPurchases    Decimal                          @default(0) @db.Decimal(18, 2)
  deductibleExpenses    Decimal                          @default(0) @db.Decimal(18, 2)
  fixedAssetPurchases   Decimal                          @default(0) @db.Decimal(18, 2)
  nonDeductibleExpenses Decimal                          @default(0) @db.Decimal(18, 2)
  vatNonComputable      Decimal                          @default(0) @db.Decimal(18, 2)
  grossIncomeTax        Decimal                          @default(0) @db.Decimal(18, 2)
  createdAt             DateTime                         @default(now())

  consolidationSnapshot AnnualFiscalConsolidationSnapshot @relation(fields: [consolidationSnapshotId], references: [id], onDelete: Cascade)
  fiscalPeriod          FiscalPeriod                     @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)

  @@unique([consolidationSnapshotId, fiscalPeriodId])
  @@index([fiscalPeriodId])
}

// ==========================================
// 5. PAPELES DE TRABAJO Y TRANSACCIONES
// ==========================================

model SalesInvoice {
  id            String    @id @default(uuid())
  taxReturnId   String
  taxReturn     TaxReturn @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)

  date          DateTime
  invoiceType   String    // Factura A, Factura B, Factura C...
  invoiceNumber String
  customerName  String
  counterpartyCuit String?
  netAmount     Decimal   @db.Decimal(18, 2)
  ivaAmount     Decimal   @db.Decimal(18, 2)
  totalAmount   Decimal   @db.Decimal(18, 2)
  isExempt      Boolean   @default(false) // Soporte para Ingresos Exentos (Monotributo/Exenciones)
  // Trazabilidad de la importación desde el libro fiscal mensual (módulo IVA). Nulos = carga manual.
  importSource         String? // 'MONTHLY_LEDGER' si vino del módulo mensual; null si se cargó a mano.
  sourceFiscalDocumentId String? // Comprobante mensual de origen, para auditar registro anual ↔ mensual.
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([taxReturnId])
  @@index([taxReturnId, invoiceNumber])
  @@index([counterpartyCuit])
  @@index([taxReturnId, importSource])
}

model PurchaseInvoice {
  id            String    @id @default(uuid())
  taxReturnId   String
  taxReturn     TaxReturn @relation(fields: [taxReturnId], references: [id], onDelete: Cascade)

  date          DateTime
