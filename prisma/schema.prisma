  totalGeneralDeductions Decimal @db.Decimal(18, 2)
  impositiveResultBeforeQuebrantos Decimal @db.Decimal(18, 2)
  quebrantosApplied     Decimal   @db.Decimal(18, 2)
  impositiveResultNet   Decimal   @db.Decimal(18, 2)
