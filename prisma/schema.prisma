  axiNetAdjustment      Decimal   @db.Decimal(18, 2) // Sumatoria AXI neto imputado en el ejercicio
  
  // Datos TÃ©cnicos / AuditorÃ­a
  variablesSnapshot     String?   @db.LongText // Almacenamiento JSON con las variables intermedias
  hasErrors             Boolean   @default(false)
  errorMessages         String?   @db.Text

  @@index([taxReturnId])
